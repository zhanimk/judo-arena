# cp deploy/vps.env.example .env.vps
DOMAIN=judo.example.com
# Use hex secrets (URL-safe): openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
KASPI_CALLBACK_SECRET=
BACKUP_TRIGGER_SECRET=
# Production email and private object storage are required by API validation.
RESEND_API_KEY=
EMAIL_FROM=Judo-Arena <noreply@example.com>
S3_PRIVATE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
# For S3-compatible storage, uncomment and set endpoint:
# S3_ENDPOINT=https://storage.example.com
BACKUP_SCHEDULER_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_RETAIN_DAYS=30
